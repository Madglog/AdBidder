// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  ADVERTISER
  OWNER
  ADMIN
}

enum AdSpaceType {
  BILLBOARD
  WALL_WRAP
  KIOSK
  TRANSIT_SHELTER
  DIGITAL_SCREEN
  ROOFTOP
  VEHICLE_WRAP
  OTHER
}

enum AdSpaceStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  ACTIVE
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PENDING_PAYMENT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  BID_DEPOSIT
  CAMPAIGN_PAYMENT
  PAYOUT
  REFUND
  PLATFORM_FEE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  BID_REJECTED
  BID_COUNTERED
  CAMPAIGN_STARTED
  CAMPAIGN_ENDED
  PAYMENT_RECEIVED
  MESSAGE_RECEIVED
  SPACE_APPROVED
  SPACE_REJECTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            UserRole  @default(GUEST)
  verified        Boolean   @default(false)
  verificationToken String?
  businessName    String?
  businessDetails String?   @db.Text
  phone           String?
  avatar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  adSpaces        AdSpace[]
  bids            Bid[]
  campaigns       Campaign[]
  transactions    Transaction[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications   Notification[]
  reviews         Review[] @relation("ReviewsGiven")
  receivedReviews Review[] @relation("ReviewsReceived")
  favorites       Favorite[]

  @@index([email])
  @@index([role])
}

model AdSpace {
  id              String        @id @default(cuid())
  ownerId         String
  title           String
  description     String        @db.Text
  type            AdSpaceType
  status          AdSpaceStatus @default(PENDING)

  // Location
  address         String
  city            String
  state           String
  country         String
  zipCode         String?
  latitude        Float
  longitude       Float

  // Specifications
  width           Float         // in feet or meters
  height          Float
  unit            String        @default("feet")

  // Pricing
  basePrice       Float         // base price per day or month
  pricingUnit     String        @default("month") // day, week, month
  instantBook     Boolean       @default(false)
  minBidPrice     Float?

  // Visibility & Analytics
  visibilityScore Int?          // 1-10
  trafficEstimate Int?          // daily traffic
  viewCount       Int           @default(0)

  // Media
  photos          String[]      // Array of photo URLs

  // Availability
  availableFrom   DateTime?
  availableTo     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bids            Bid[]
  campaignSpaces  CampaignSpace[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([city, state])
  @@index([latitude, longitude])
}

model Bid {
  id              String      @id @default(cuid())
  advertiserId    String
  spaceId         String
  amount          Float
  duration        Int         // in days
  startDate       DateTime
  endDate         DateTime
  status          BidStatus   @default(PENDING)
  message         String?     @db.Text
  counterAmount   Float?
  counterMessage  String?     @db.Text
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  advertiser      User        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  space           AdSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  campaign        Campaign?   @relation(fields: [campaignId], references: [id])
  campaignId      String?

  @@index([advertiserId])
  @@index([spaceId])
  @@index([status])
  @@index([expiresAt])
}

model Campaign {
  id              String          @id @default(cuid())
  advertiserId    String
  title           String
  description     String?         @db.Text
  startDate       DateTime
  endDate         DateTime
  status          CampaignStatus  @default(DRAFT)
  totalBudget     Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  advertiser      User            @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  spaces          CampaignSpace[]
  bids            Bid[]
  transactions    Transaction[]

  @@index([advertiserId])
  @@index([status])
  @@index([startDate, endDate])
}

model CampaignSpace {
  id              String    @id @default(cuid())
  campaignId      String
  spaceId         String
  creativeUrl     String?   // URL to the ad creative
  creativeNotes   String?   @db.Text
  price           Float     // final agreed price
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime  @default(now())

  // Relations
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  space           AdSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, spaceId])
  @@index([campaignId])
  @@index([spaceId])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  campaignId        String?
  amount            Float
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  stripePaymentId   String?           @unique
  stripePayoutId    String?           @unique
  description       String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign          Campaign?         @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Message {
  id              String    @id @default(cuid())
  senderId        String
  receiverId      String
  subject         String?
  content         String    @db.Text
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now())

  // Relations
  sender          User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([read])
  @@index([createdAt])
}

model Notification {
  id              String            @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  content         String            @db.Text
  read            Boolean           @default(false)
  link            String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Review {
  id              String    @id @default(cuid())
  reviewerId      String
  spaceId         String
  ownerId         String    // denormalized for easier queries
  rating          Int       // 1-5
  comment         String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  reviewer        User      @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  space           AdSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner           User      @relation("ReviewsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, spaceId])
  @@index([spaceId])
  @@index([ownerId])
  @@index([rating])
}

model Favorite {
  id              String    @id @default(cuid())
  userId          String
  spaceId         String
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space           AdSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
}
